          "noValue": "No agreements"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "namePlacement": "left"
      },
      "description": "Rental agreements in each state, counted in the database of the rental-service.",
      "id": 14
    },
    {
      "type": "bargauge",
      "title": "Reservations by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (status) (rentporto_booking_reservations)",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "min": 0,
          "noValue": "The booking-service does not expose its reservations yet"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "namePlacement": "left"
      },
      "description": "Reservations in each state, counted in the database of the booking-service.",
      "id": 15
    }
  ]
}
